<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ hides other apps by default: declare the text-to-speech engine we talk to. -->
    <!-- Read-aloud keeps playing with the screen off, with lock-screen controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- For one thing only: downloading a natural voice from GitHub, once, after the listener
         agrees (voice/VoiceDownload.kt, the only code that opens a connection; a unit test,
         NetworkUseTest, keeps it that way). Books can't use it: their pages' web views are kept
         off the network (reader/OfflinePages.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Whether the phone is online, and on mobile data, so the voice's size is said and agreed to
         first. (WorkManager, under the widgets, asked for it already.) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Translate, Define and other text actions offered on selected text. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".JacketApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jacket">

        <!-- configChanges keeps the activity (and the outer-display session) alive across fold/unfold,
             and a book open through a change of the phone's font size: its pages re-flow in place. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with Jacket" from file managers, downloads and other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-zip-compressed-fb2" />
            </intent-filter>

            <!-- An FB2 book held by an app that doesn't know what it is (most don't: to them it is
                 XML, a zip, or nothing in particular). It is told by the end of its name, so that
                 Jacket is offered for it and not for every other file of those kinds. Android 12
                 and later compare the name's end itself (pathSuffix); before that there are only
                 patterns, which stop at the first full stop they meet, so one for each number of
                 full stops a name is likely to have. A link that doesn't carry the file's name
                 can't be told this way: those files are added with the + button. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:pathSuffix=".fb2" tools:targetApi="s" />
                <data android:pathSuffix=".fb2.zip" tools:targetApi="s" />
                <data android:pathSuffix=".fbz" tools:targetApi="s" />
                <data android:pathPattern=".*\\.fb2" />
                <data android:pathPattern=".*\\..*\\.fb2" />
                <data android:pathPattern=".*\\..*\\..*\\.fb2" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fb2" />
                <data android:pathPattern=".*\\.fb2\\.zip" />
                <data android:pathPattern=".*\\..*\\.fb2\\.zip" />
                <data android:pathPattern=".*\\..*\\..*\\.fb2\\.zip" />
                <data android:pathPattern=".*\\.fbz" />
                <data android:pathPattern=".*\\..*\\.fbz" />
            </intent-filter>

            <!-- "Share to Jacket". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/x-fictionbook+xml" />
                <data android:mimeType="application/x-fictionbook" />
                <data android:mimeType="application/x-zip-compressed-fb2" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Read-aloud in the background: Media3 posts the media notification and lock-screen
             controls, and keeps the voice going with the screen off. It can be started with
             nothing playing and asked to play: it resumes the book being read. As a library
             service it also says what can be listened to (the book being read, and recent ones),
             which is what a car's screen shows; only the system, a car and apps allowed to see
             notifications are told (see ListenService). -->
        <service
            android:name=".reader.ListenService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- A headphone button pressed when nothing is playing, even after Android has closed
             Jacket: Android sends it here, and read-aloud resumes the book being read. -->
        <receiver
            android:name=".reader.ResumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Home-screen widget; the Samsung meta-data also offers it on the Galaxy Z Flip cover screen (Flex Window). -->
        <receiver
            android:name=".widget.CoverWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cover_widget_info" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_cover_widget" />
        </receiver>

        <!-- The book with a play button; also on the Flex Window, to pause or resume without opening the phone. -->
        <receiver
            android:name=".widget.PlayerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_player_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/player_widget_info" />
            <meta-data
                android:name="com.samsung.android.appwidget.provider"
                android:resource="@xml/samsung_cover_widget" />
        </receiver>

        <!-- The books you're reading, side by side. -->
        <receiver
            android:name=".widget.ShelfWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_shelf_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shelf_widget_info" />
        </receiver>

        <!-- Minutes read today, the streak and the week. -->
        <receiver
            android:name=".widget.StreakWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_streak_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget_info" />
        </receiver>
    </application>
</manifest>
