<?xml version="1.0" encoding="utf-8"?>
<!-- The player widget in the picker on Android 12 to 14; Android 15 draws the real one.
     The launcher inflates it as RemoteViews, with framework views, so android:tint is the tint that works here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    tools:ignore="UseAppTint"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="31dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_brand_mark" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:max="100"
        android:progress="42" />

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_preview_tile"
        android:backgroundTint="#FFF4C76B"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_widget_play"
        android:tint="#FF16424A" />
</LinearLayout>
