<?xml version="1.0" encoding="utf-8"?>
<!-- Natural voices, the welcome pages and the sample book: in a file of their own, beside strings.xml. -->
<resources>
    <!-- Settings: the group that holds the voice. -->
    <string name="settings_group_listening">Listening</string>

    <!-- The voice that reads books aloud. Plain words throughout: no "engine", "model" or "TTS". -->
    <string name="voice_title">Voice</string>
    <!-- The text-to-speech voice built into the phone, as opposed to Jacket's natural voices. -->
    <string name="voice_phone">Phone\'s voice</string>
    <string name="voice_phone_description">Built into your phone. Reads every language it knows.</string>
    <!-- A short mark on voices that sound like a person rather than a machine. -->
    <string name="voice_natural">Natural</string>
    <!-- The natural voices have no names, only numbers: "Female voice 2". -->
    <string name="voice_female">Female voice %1$d</string>
    <string name="voice_male">Male voice %1$d</string>
    <!-- Button that plays a short sample of a voice. %1$s is the voice's name. -->
    <string name="voice_hear">Hear %1$s</string>
    <string name="voice_stop_sample">Stop</string>
    <string name="voice_change">Change</string>
    <!-- %1$s is a language, e.g. "English". -->
    <string name="voice_book_language">This book is in %1$s</string>
    <string name="voice_book_language_hint">Not right? Change it, so the right voice reads it.</string>
    <string name="voice_language_title">What language is this book in?</string>
    <!-- Under the language the book itself declares, in the list of languages. -->
    <string name="voice_language_from_book">What the book says</string>
    <!-- A switch. %1$s is a language, e.g. "English". -->
    <string name="voice_only_language">Only for books in %1$s</string>
    <string name="voice_only_language_description">Books in other languages keep their own voice.</string>
    <!-- %1$s is a language, e.g. "Chinese". -->
    <string name="voice_not_in_language">The natural voices don\'t speak %1$s yet, so your phone\'s voice reads this.</string>
    <string name="voice_private">Natural voices speak on your phone itself. Nothing you read is sent anywhere.</string>
    <string name="voice_about">About these voices</string>
    <string name="voice_about_text">Natural voices are downloaded once, from GitHub, and then work without the internet. They are free to use, but must not be used to deceive or harm anyone, for example by passing a voice off as a real person. The full terms are in Settings, under Licenses.</string>
    <!-- On the player, when the phone is too slow for the natural voice. Keep it short. -->
    <string name="voice_slow">This voice is too much for this phone. Tap to change it.</string>
    <!-- On the player's button while a natural voice loads, before its first word. -->
    <string name="listen_preparing">Getting the voice ready…</string>
    <string name="voice_fell_back">The natural voice couldn\'t start, so your phone\'s voice is reading.</string>
    <string name="voice_phone_settings">Phone\'s voice settings</string>
    <string name="voice_phone_settings_description">Choose how your phone\'s own voice sounds.</string>
    <string name="voice_settings_hint">Each book is read in its own language. Natural voices speak many languages; your phone\'s voice reads the rest.</string>

    <!-- The welcome, shown once before the first book. -->
    <string name="onboarding_cover_body">While you read inside, the outer screen wears your book\'s cover. Close the phone and the cover stays on; stand it half-open and the page sits above the fold.</string>
    <string name="onboarding_cover_outside">Cover on the outside</string>
    <string name="onboarding_read_title">Real pages, turned like paper</string>
    <string name="onboarding_read_body">Pages lift under your finger and slide, curl or deal away. Press and hold any words to highlight them and add a note.</string>
    <!-- Foldables get reading and listening on one page. -->
    <string name="onboarding_read_listen_body">Pages turn like paper, two side by side when the phone is open. Or sit back and listen: natural voices read any book aloud.</string>
    <string name="onboarding_listen_title">Or just listen</string>
    <string name="onboarding_listen_body">Natural voices read any book aloud, each word lighting up as it\'s spoken. It keeps going with the screen off.</string>
    <string name="onboarding_yours_title">Make it yours</string>
    <string name="onboarding_yours_body">A few choices to start with. You can change them any time.</string>
    <!-- A line of sample text, shown in the chosen typeface and page colour. -->
    <string name="onboarding_yours_sample">Once upon a time, a book found its reader.</string>
    <string name="onboarding_start_title">Your books stay yours</string>
    <string name="onboarding_widget">Keep your book\'s cover on your home screen with Jacket\'s widget.</string>

    <!-- The empty library on a phone that doesn't fold (the foldable wording is in strings.xml). -->
    <string name="library_empty_title_phone">Your next book starts here</string>
    <string name="library_empty_message_phone">Add an EPUB, PDF, CBZ comic or text file. Jacket keeps a private copy, gives it real pages to turn, and can read it aloud in a natural voice.</string>

    <!-- A free classic that comes with the app, to try the reader without having a file. -->
    <string name="library_try_sample">Try a sample book</string>
    <string name="sample_failed">The sample book couldn\'t be opened.</string>

    <!-- "Say it this way": the listener tells the voice how a name or a made-up word sounds, by writing it the way it is said. Plain words: no "pronunciation dictionary", "phonetic" or "lexicon". This is also the entry in the menu over selected words. -->
    <string name="say_title">Say it this way</string>
    <string name="say_hint">Tell the voice how a name or a word should sound.</string>
    <!-- Field labels: the word as the book writes it, and the same word written the way it sounds. -->
    <string name="say_word">Word in the book</string>
    <string name="say_sounds">Sounds like</string>
    <!-- Under the "Sounds like" field. The example is a name written the way it sounds; use one that works in your language. -->
    <string name="say_sounds_example">Write it the way it sounds, like: her-MY-oh-nee</string>
    <!-- Button: says the word in the voice that reads the book. -->
    <string name="say_hear">Hear it</string>
    <!-- A switch: off, the word is said this way only in the book that is open. -->
    <string name="say_every_book">Use in every book</string>
    <!-- Beside a word in the list that is said this way in all books. -->
    <string name="say_scope_all">Every book</string>
    <string name="say_add">Add a word</string>
    <!-- For screen readers, on the bin beside a word. %1$s is the word. -->
    <string name="say_remove">Remove %1$s</string>
    <string name="say_empty">No words yet. Press and hold a word on the page and choose “Say it this way”, or add one here.</string>
    <!-- A switch: the voice doesn't say the small numbers in the text that point to footnotes and endnotes. -->
    <string name="listen_skip_notes">Skip note numbers</string>
    <string name="listen_skip_notes_description">The voice doesn\'t read out the small numbers that point to notes.</string>

    <!-- Downloading the natural voices (see voice/VoiceDownloads.kt). -->
    <!-- The natural voices are downloaded once, from GitHub, the first time someone listens. Plain words: no "model", "TTS" or "AI". -->
    <!-- Shown in a sheet on the first Listen of a book whose voice isn't on the phone yet; the phone's own voice reads meanwhile. -->
    <string name="voice_offer_title">Download a natural voice?</string>
    <!-- The same sheet's title for someone updating from a version that had the voices inside the app. -->
    <string name="voice_offer_title_updated">Natural voices now download separately</string>
    <string name="voice_offer_updated">To keep Jacket small, the voices are no longer inside the app. Download yours once and it reads as before. The voice you chose is kept.</string>
    <!-- %1$s is a size, e.g. "145 MB". -->
    <string name="voice_offer_body">A voice that sounds like a person reads your books, right on your phone. It\'s a one-time download of %1$s.</string>
    <!-- What the download reveals, plainly. Keep "GitHub" and "IP address". -->
    <string name="voice_offer_privacy">Jacket connects once, to GitHub, to get the voice. GitHub sees your IP address, as with any download. Nothing about you or your books is sent.</string>
    <!-- Shown when the phone is on mobile data. %1$s is a size, e.g. "145 MB". -->
    <string name="voice_offer_mobile">You\'re on mobile data: this uses %1$s of it.</string>
    <string name="voice_offer_meanwhile">Your phone\'s voice reads until it\'s ready.</string>
    <!-- Buttons. %1$s is a size, e.g. "145 MB". -->
    <string name="voice_download">Download (%1$s)</string>
    <string name="voice_download_mobile">Download on mobile data (%1$s)</string>
    <!-- For screen readers, on the button beside a voice that isn't on the phone yet. %1$s is the voice's name. -->
    <string name="voice_download_named">Download %1$s</string>
    <string name="voice_use_phone">Use the phone\'s voice</string>
    <!-- The same sheet when another natural voice (one already on the phone) is reading meanwhile. -->
    <string name="voice_offer_meanwhile_natural">The voice reading now carries on until it\'s ready.</string>
    <string name="voice_keep_current">Keep the voice reading now</string>
    <!-- A short message once a voice has downloaded. -->
    <string name="voice_download_ready">The natural voice is ready.</string>
    <!-- On the player and beside a voice while it downloads. %1$s is a percentage, e.g. "42%". -->
    <string name="voice_downloading">Downloading voice, %1$s</string>
    <string name="voice_download_again">Try again</string>
    <!-- Settings › Voice: the natural voices, each to download or remove. -->
    <string name="voice_packs_title">Voice downloads</string>
    <!-- What a set of voices is: "Natural voices in 31 languages". -->
    <plurals name="voice_pack_many">
        <item quantity="one">Natural voices in %1$d language</item>
        <item quantity="other">Natural voices in %1$d languages</item>
    </plurals>
    <!-- A voice for one language. %1$s is a language with its country, e.g. "Portuguese (Brazil)". -->
    <string name="voice_pack_one">Natural voice in %1$s</string>
    <!-- A voice that came inside the app (only in builds made that way). -->
    <string name="voice_pack_in_app">Comes with this copy of Jacket</string>
    <!-- %1$s is a size, e.g. "145 MB". -->
    <string name="voice_pack_ready">On this phone · %1$s</string>
    <!-- %1$s is a percentage, %2$s a size: "Downloading · 42% of 145 MB". -->
    <string name="voice_pack_downloading">Downloading · %1$s of %2$s</string>
    <!-- Part of it is on the phone. %1$s and %2$s are sizes: "Stopped at 61 MB of 145 MB". -->
    <string name="voice_pack_paused">Stopped at %1$s of %2$s</string>
    <!-- A voice not on the phone yet. %1$s is a size: "145 MB download". -->
    <string name="voice_pack_size">%1$s download</string>
    <string name="voice_remove">Remove</string>
    <string name="voice_remove_title">Remove this voice?</string>
    <!-- %1$s is a size, e.g. "145 MB". -->
    <string name="voice_remove_body">This frees %1$s on your phone. Your phone\'s voice reads instead, and you can download this one again any time.</string>
    <!-- Why a download stopped, in plain words. -->
    <string name="voice_problem_offline">You\'re not connected to the internet. Connect, then try again.</string>
    <string name="voice_problem_unreachable">Couldn\'t reach GitHub. Try again later.</string>
    <string name="voice_problem_damaged">The download was damaged, so it was deleted. Try again.</string>
    <!-- %1$s is a size, e.g. "195 MB". -->
    <string name="voice_problem_space">Not enough space: the voice needs %1$s free on your phone.</string>
    <string name="voice_problem_mobile">Stopped because your phone switched to mobile data.</string>
    <string name="voice_problem_storage">Couldn\'t save the voice on this phone. Try again.</string>
</resources>
