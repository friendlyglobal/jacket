<?xml version="1.0" encoding="utf-8"?>
<!-- Books can be large and are the user's own files: keep them out of cloud backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
