<?xml version="1.0" encoding="utf-8"?>
<!-- A bar one row high by default; taller, the cover grows with it. Also offered on the Flex Window. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_player_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewImage="@drawable/widget_preview_image"
    android:previewLayout="@layout/widget_preview_player"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen|keyguard" />
