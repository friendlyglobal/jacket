    <string name="voice_book_language">책의 언어: %1$s</string>
    <string name="voice_book_language_hint">맞지 않나요? 변경하면 알맞은 음성으로 읽어 줍니다.</string>
    <string name="voice_language_title">이 책은 어떤 언어인가요?</string>
